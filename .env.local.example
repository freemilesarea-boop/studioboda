# =========================================================
# Supabase — STUDIOBODA dedicated project
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://wxdlcjgvclyygjvimhgn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# =========================================================
# Initial admin (used by `npm run create-admin`)
# =========================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=STUDIO BODA Ops

# =========================================================
# PayApp — never paste keys into source / chat. Vercel env only.
# Set the following in Vercel → Settings → Environment Variables (Production + Preview + Development):
# =========================================================
PAYAPP_SHOP_ID=
PAYAPP_API_KEY=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=

# =========================================================
# Resend (email automation)
# =========================================================
RESEND_API_KEY=
RESEND_FROM=STUDIO BODA <hello@studioboda.kr>

# =========================================================
# AI (provider abstraction — set one or both, AI_PROVIDER picks the default)
# =========================================================
AI_PROVIDER=anthropic        # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =========================================================
# Cron (Vercel Cron → /api/cron/ops, daily 09:00 KST)
# Requests must send: Authorization: Bearer $CRON_SECRET. Otherwise 401.
# =========================================================
CRON_SECRET=

# =========================================================
# App
# =========================================================
NEXT_PUBLIC_SITE_URL=https://studioboda.vercel.app
